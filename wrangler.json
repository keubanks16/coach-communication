{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coach-communication",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "coach-communication",
    "migrations_dir": "cloudflare/migrations"
  }],
  "secrets": { "required": ["PAIRING_KEY"] }
}
