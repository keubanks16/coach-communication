{
  "name": "coach-communication-cloudflare",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "wrangler dev",
    "test": "wrangler deploy --dry-run --outdir .wrangler/test-build && node --test cloudflare/test.mjs",
    "check": "wrangler deploy --dry-run",
    "deploy": "node cloudflare/deploy.mjs"
  },
  "dependencies": { "web-push": "3.6.7" },
  "cloudflare": {
    "bindings": {
      "PAIRING_KEY": { "description": "Choose a private key of at least 10 characters. Both coaches enter this same key once when pairing their phones." },
      "DB": { "description": "Stores the two coach pairings, notification subscriptions, calls, and notification keys." }
    }
  },
  "devDependencies": {
    "miniflare": "^5.20261006.1-alpha",
    "wrangler": "^4.149.0"
  }
}
